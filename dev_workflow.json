{
  "provider": "mock",
  "models": {
    "proposal": "gpt-5",
    "discussion": "gpt-5",
    "implementation": "gpt-5",
    "validation": "gpt-5"
  },
  "minimax": {
    "base_url": "https://api.minimaxi.com/v1",
    "model": "MiniMax-M2.7"
  },
  "context": {
    "max_chars": 120000,
    "extensions": [".gd", ".tscn", ".json", ".md", ".ps1", ".cfg"]
  },
  "validation_commands": [
    ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/validate_content.ps1"],
    ["${GODOT_BIN}", "--headless", "--path", ".", "--quit-after", "3"],
    ["git", "diff", "--check"]
  ]
}
